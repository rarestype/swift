#!/bin/bash
# Builds unsigned swift-syntax prebuilts for each of $SWIFT_SYNTAX_VERSIONS, with the
# `swift-build-prebuilts` from Scripts/BuildSwiftPM and the compiler on the PATH, as
# `prebuilts/swift-syntax/<version>/<toolchain>-<platform>{.unsigned,-MacroSupport.tar.gz}`.
set -euo pipefail
: "${SWIFT_SYNTAX_VERSIONS:?}"

ROOT="$PWD"
tool="$ROOT/swiftpm/.build/release/swift-build-prebuilts"

versions=()
for version in $SWIFT_SYNTAX_VERSIONS; do
    versions+=(--version "$version")
done

mkdir -p prebuilts
(cd prebuilts && "$tool" --stage-dir "$ROOT/prebuilts" --build "${versions[@]}")
rm -rf prebuilts/src
echo "💖 swift-syntax prebuilts built for $(uname -m)"
